<UserControl x:Class="WpfMvvmTemplate.Views.SearchResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WpfMvvmTemplate.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SearchResultViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1280"
             Background="{StaticResource WindowBackgroundBrush}"
             FontFamily="Pretendard, Malgun Gothic, Segoe UI"
             UseLayoutRounding="True"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. 상단 풀폭 헤더 바 -->
        <Border Grid.Row="0"
                Padding="24,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Path Width="18"
                          Height="18"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          Data="{StaticResource IconSearchChart}"
                          Stretch="Uniform"
                          Stroke="{StaticResource PrimaryBrush}"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.75" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="16.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="결과 조회" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button MinWidth="98"
                            Margin="0,0,8,0"
                            Background="{StaticResource DangerFgBrush}"
                            Command="{Binding DeleteRecordCommand}"
                            Style="{StaticResource ModernButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15"
                                  Height="15"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource IconTrash}"
                                  Stretch="Uniform"
                                  Stroke="White"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.75" />
                            <TextBlock VerticalAlignment="Center" Text="삭제" />
                        </StackPanel>
                    </Button>

                    <Button MinWidth="98"
                            Margin="0,0,8,0"
                            Background="{StaticResource PrimaryBrush}"
                            Command="{Binding PrintCommand}"
                            Style="{StaticResource ModernButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15"
                                  Height="15"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource IconPrinter}"
                                  Stretch="Uniform"
                                  Stroke="White"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.75" />
                            <TextBlock VerticalAlignment="Center" Text="인쇄" />
                        </StackPanel>
                    </Button>

                    <Button Background="White"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            Command="{Binding ReturnToMainCommand}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Style="{StaticResource ModernButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15"
                                  Height="15"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource IconHome}"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.75" />
                            <TextBlock VerticalAlignment="Center" Text="메인 화면" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 검색 조건 필터 카드 -->
        <Border Grid.Row="1"
                Margin="18,16,18,0"
                Padding="18,14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Effect="{StaticResource SoftCardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 조회 기간 -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Margin="2,0,0,6"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="#475569"
                               Text="조회 기간" />
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding StartDate}" Style="{StaticResource ModernDatePickerStyle}" />
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"
                                   Text="~" />
                        <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource ModernDatePickerStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- 통합 키워드 검색 -->
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Margin="2,0,0,6"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="#475569"
                               Text="검색어 (시험번호·차량·시리얼)" />
                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <!-- 판정 결과 필터 -->
                <StackPanel Grid.Column="2" Margin="0,0,20,0">
                    <TextBlock Margin="2,0,0,6"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="#475569"
                               Text="판정 결과" />
                    <ComboBox ItemsSource="{Binding JudgmentOptions}"
                              SelectedItem="{Binding SelectedJudgmentFilter}"
                              Style="{StaticResource ModernComboBoxStyle}" />
                </StackPanel>

                <!-- 검색 / 초기화 버튼 -->
                <StackPanel Grid.Column="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <Button Width="98"
                            Background="{StaticResource AccentHoverBrush}"
                            Command="{Binding SearchCommand}"
                            Content="검색"
                            Style="{StaticResource ModernButtonStyle}" />
                    <Button Width="92"
                            Margin="8,0,0,0"
                            Background="#F1F5F9"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Command="{Binding ResetFilterCommand}"
                            Content="초기화"
                            Foreground="#475569"
                            Style="{StaticResource ModernButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. 본문: 좌측 이력 목록 / 우측 상세 결과 -->
        <Grid Grid.Row="2" Margin="18,14,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 좌측: 이력 목록 -->
            <Border Grid.Column="0"
                    Margin="0,0,14,0"
                    Padding="16"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource SoftCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,12">
                        <TextBlock FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Text="조회 이력 목록" />
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding FilteredRecords.Count, StringFormat={}{0}건}" />
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              ItemsSource="{Binding FilteredRecords}"
                              SelectedItem="{Binding SelectedRecord}"
                              Style="{StaticResource ModernDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="180"
                                                Binding="{Binding TestNumber}"
                                                FontFamily="Consolas"
                                                FontWeight="Bold"
                                                Header="시험 번호" />
                            <DataGridTextColumn Width="*"
                                                Binding="{Binding TestedDate}"
                                                Foreground="#475569"
                                                Header="시험 일자" />
                            <DataGridTemplateColumn Width="84"
                                                    Header="판정"
                                                    HeaderStyle="{StaticResource CenteredDataGridHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="54"
                                                Height="24"
                                                HorizontalAlignment="Center"
                                                CornerRadius="12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OverallResult}" Value="NG">
                                                            <Setter Property="Background" Value="#FEE2E2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Text="{Binding OverallResult}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#15803D" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OverallResult}" Value="NG">
                                                                <Setter Property="Foreground" Value="#B91C1C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 우측: 상세 계측 결과 -->
            <Border Grid.Column="1"
                    Padding="20"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource SoftCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 상세 헤더 -->
                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,12"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Border Width="4"
                                Height="18"
                                Margin="0,0,10,0"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="2" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="15.5"
                                   FontWeight="ExtraBold"
                                   Foreground="#0F172A"
                                   Text="상세 결과" />
                    </StackPanel>

                    <!-- 요약 카드 1행 -->
                    <UniformGrid Grid.Row="1"
                                 Margin="0,0,0,10"
                                 Columns="4">
                        <Border Margin="0,0,10,0" Style="{StaticResource SummaryMetricCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="시험 번호" />
                                <TextBlock Margin="0,5,0,0"
                                           FontFamily="Consolas"
                                           FontSize="16"
                                           FontWeight="ExtraBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="{Binding SelectedRecord.TestNumber, FallbackValue=-}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,10,0" Style="{StaticResource SummaryMetricCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="시험 일자" />
                                <TextBlock Margin="0,5,0,0"
                                           FontFamily="Consolas"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Text="{Binding SelectedRecord.TestedAt, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue=-, FallbackValue=-}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,10,0" Style="{StaticResource SummaryMetricCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="합격 항목" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock FontFamily="Consolas"
                                               FontSize="17"
                                               FontWeight="ExtraBold"
                                               Foreground="#0F172A"
                                               Text="{Binding SelectedRecord.PassedCount, FallbackValue=0}" />
                                    <TextBlock Margin="4,2,0,0"
                                               FontFamily="Consolas"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding SelectedRecord.ItemCount, StringFormat=/ {0} 항목, FallbackValue=/ 0 항목}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SummaryMetricCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="종합 판정" />
                                <Border Margin="0,5,0,0"
                                        Padding="14,3"
                                        HorizontalAlignment="Left"
                                        CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRecord.OverallResult}" Value="NG">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedRecord}" Value="{x:Null}">
                                                    <Setter Property="Background" Value="#E2E8F0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="14"
                                               FontWeight="ExtraBold"
                                               Text="{Binding SelectedRecord.OverallResult, FallbackValue=-}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#15803D" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedRecord.OverallResult}" Value="NG">
                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedRecord}" Value="{x:Null}">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 메타 정보 카드 2행 -->
                    <UniformGrid Grid.Row="2"
                                 Margin="0,0,0,14"
                                 Columns="4">
                        <Border Margin="0,0,10,0" Style="{StaticResource SummaryMetricCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="시험자" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Text="{Binding SelectedRecord.TesterName, FallbackValue=-}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,10,0" Style="{StaticResource SummaryMetricCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="차량번호" />
                                <TextBlock Margin="0,5,0,0"
                                           FontFamily="Consolas"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Text="{Binding SelectedRecord.CarNumber, FallbackValue=-}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,10,0" Style="{StaticResource SummaryMetricCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="편성번호" />
                                <TextBlock Margin="0,5,0,0"
                                           FontFamily="Consolas"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Text="{Binding SelectedRecord.FormationNumber, FallbackValue=-}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SummaryMetricCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="시리얼넘버" />
                                <TextBlock Margin="0,5,0,0"
                                           FontFamily="Consolas"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Text="{Binding SelectedRecord.SerialNumber, FallbackValue=-}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 항목별 상세 테이블 -->
                    <DataGrid Grid.Row="3"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              ItemsSource="{Binding SelectedRecord.Details}"
                              Style="{StaticResource ModernDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="58"
                                                Binding="{Binding StepNo}"
                                                Header="순번" />
                            <DataGridTextColumn Width="160"
                                                Binding="{Binding ItemName}"
                                                FontWeight="Bold"
                                                Header="항목명" />
                            <DataGridTextColumn Width="90"
                                                Binding="{Binding Category}"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource PrimaryBrush}"
                                                Header="구분" />
                            <DataGridTextColumn Width="*"
                                                Binding="{Binding StandardSpec}"
                                                Foreground="#475569"
                                                Header="기준 규격" />
                            <DataGridTextColumn Width="180"
                                                Binding="{Binding MeasuredValue}"
                                                FontFamily="Consolas"
                                                FontWeight="Bold"
                                                Header="측정값" />
                            <DataGridTemplateColumn Width="90"
                                                    Header="판정"
                                                    HeaderStyle="{StaticResource CenteredDataGridHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="58"
                                                Height="24"
                                                HorizontalAlignment="Center"
                                                CornerRadius="12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Result}" Value="NG">
                                                            <Setter Property="Background" Value="#FEE2E2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Text="{Binding Result}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#15803D" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="NG">
                                                                <Setter Property="Foreground" Value="#B91C1C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

