<Window x:Class="WpfMvvmTemplate.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WpfMvvmTemplate.ViewModels"
        Title="{Binding WindowTitle}"
        MinWidth="1024"
        MinHeight="640"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        FontFamily="Pretendard, Malgun Gothic, Segoe UI"
        UseLayoutRounding="True"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        mc:Ignorable="d">

    <Grid>
        <ContentControl Content="{Binding Navigation.CurrentViewModel}" />
        <ContentControl Content="{Binding Navigation.CurrentModalViewModel}" />
    </Grid>
</Window>
