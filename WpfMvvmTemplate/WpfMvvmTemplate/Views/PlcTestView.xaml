<UserControl x:Class="WpfMvvmTemplate.Views.PlcTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WpfMvvmTemplate.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:PlcTestViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1280"
             Background="{StaticResource WindowBackgroundBrush}"
             FontFamily="Pretendard, Malgun Gothic, Segoe UI"
             UseLayoutRounding="True"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. 상단 풀폭 헤더 바 -->
        <Border Grid.Row="0"
                Padding="24,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Path Width="18"
                          Height="18"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          Data="{StaticResource IconPlcChip}"
                          Stretch="Uniform"
                          Stroke="{StaticResource WarningFgBrush}"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="1.75" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="16.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="PLC 통신 사전 테스트 (개발 전용)" />
                    <Border Margin="12,0,0,0"
                            Padding="10,4"
                            Background="{StaticResource WarningBgBrush}"
                            CornerRadius="6">
                        <TextBlock FontFamily="Consolas"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningFgBrush}"
                                   Text="{Binding ConnectionSummary}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Height="36"
                            Margin="0,0,12,0"
                            Padding="14,0"
                            VerticalAlignment="Center"
                            CornerRadius="18">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FEE2E2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#DCFCE7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12.5"
                                   FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#B91C1C" />
                                    <Setter Property="Text" Value="연결 해제됨" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="#15803D" />
                                            <Setter Property="Text" Value="PLC 연결됨" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Button Width="96"
                            Height="38"
                            Margin="0,0,8,0"
                            Background="{StaticResource PrimaryBrush}"
                            Command="{Binding ConnectCommand}"
                            Content="연결"
                            Style="{StaticResource ModernButtonStyle}" />

                    <Button Width="96"
                            Height="38"
                            Margin="0,0,12,0"
                            Background="#DC2626"
                            Command="{Binding DisconnectCommand}"
                            Content="해제"
                            Style="{StaticResource ModernButtonStyle}" />

                    <Button Width="106"
                            Height="38"
                            Background="#475569"
                            Command="{Binding BackToSettingsCommand}"
                            Content="설정으로"
                            Style="{StaticResource ModernButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 본문: 좌측 Bit/Word 테스트 / 우측 TX·RX 로그 -->
        <Grid Grid.Row="1" Margin="18,16,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 좌측: Bit / Word 읽기·쓰기 패널 -->
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <!-- Bit 테스트 카드 -->
                <Border Padding="20"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,14"
                                   FontSize="15.5"
                                   FontWeight="ExtraBold"
                                   Foreground="#0F172A"
                                   Text="비트 (Bit) 읽기 / 쓰기" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="2,0,0,6"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="#475569"
                                           Text="주소 (예: M0000, P0000)" />
                                <TextBox FontFamily="Consolas"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding BitAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="2,0,0,6"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="#475569"
                                           Text="현재 상태" />
                                <Border Height="40"
                                        Padding="12,0"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="14"
                                               FontWeight="ExtraBold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="{Binding BitResultText}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="3">
                            <Button Margin="0,0,8,0"
                                    Background="{StaticResource AccentHoverBrush}"
                                    Command="{Binding ReadBitCommand}"
                                    Content="읽기"
                                    Style="{StaticResource ModernButtonStyle}" />
                            <Button Margin="0,0,8,0"
                                    Background="#15803D"
                                    Command="{Binding WriteBitOnCommand}"
                                    Content="ON (1)"
                                    Style="{StaticResource ModernButtonStyle}" />
                            <Button Background="#64748B"
                                    Command="{Binding WriteBitOffCommand}"
                                    Content="OFF (0)"
                                    Style="{StaticResource ModernButtonStyle}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Word 테스트 카드 -->
                <Border Margin="0,14,0,0"
                        Padding="20"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,14"
                                   FontSize="15.5"
                                   FontWeight="ExtraBold"
                                   Foreground="#0F172A"
                                   Text="워드 (Word) 읽기 / 쓰기" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="2,0,0,6"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="#475569"
                                           Text="주소 (예: D0100)" />
                                <TextBox FontFamily="Consolas"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding WordAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="2,0,0,6"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="#475569"
                                           Text="쓰기 값 (정수)" />
                                <TextBox FontFamily="Consolas"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding WordWriteValue, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="42"
                                Margin="0,0,0,12"
                                Padding="12,0"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8">
                            <DockPanel>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="#64748B"
                                           Text="읽은 값" />
                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="14.5"
                                           FontWeight="ExtraBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Text="{Binding WordResultText}" />
                            </DockPanel>
                        </Border>

                        <UniformGrid Columns="2">
                            <Button Margin="0,0,8,0"
                                    Background="{StaticResource AccentHoverBrush}"
                                    Command="{Binding ReadWordCommand}"
                                    Content="워드 읽기"
                                    Style="{StaticResource ModernButtonStyle}" />
                            <Button Background="{StaticResource PrimaryBrush}"
                                    Command="{Binding WriteWordCommand}"
                                    Content="워드 쓰기"
                                    Style="{StaticResource ModernButtonStyle}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 우측: 통신 로그 모니터 -->
            <Border Grid.Column="1"
                    Padding="20"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource SoftCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="15.5"
                                   FontWeight="ExtraBold"
                                   Foreground="#0F172A"
                                   Text="통신 로그 (TX / RX)" />
                        <Button Width="96"
                                Height="34"
                                HorizontalAlignment="Right"
                                Background="#F1F5F9"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Command="{Binding ClearLogsCommand}"
                                Content="로그 지우기"
                                FontSize="12.5"
                                Foreground="#475569"
                                Style="{StaticResource ModernButtonStyle}" />
                    </DockPanel>

                    <ListBox Grid.Row="1"
                             Padding="8"
                             Background="#0F172A"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="13"
                             Foreground="#E2E8F0"
                             ItemsSource="{Binding Logs}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

