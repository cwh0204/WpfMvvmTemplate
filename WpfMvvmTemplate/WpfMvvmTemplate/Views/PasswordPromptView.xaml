<UserControl x:Class="WpfMvvmTemplate.Views.PasswordPromptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:WpfMvvmTemplate.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WpfMvvmTemplate.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:PasswordPromptViewModel}"
             FocusManager.FocusedElement="{Binding ElementName=PasswordInput}"
             FontFamily="Pretendard, Malgun Gothic, Segoe UI"
             UseLayoutRounding="True"
             mc:Ignorable="d">

    <Grid Background="#520F172A">
        <Border Width="450"
                Padding="34,30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource AnimatedModalCardStyle}">
            <StackPanel>
                <Path Width="34"
                      Height="34"
                      Margin="0,0,0,16"
                      HorizontalAlignment="Center"
                      Data="{StaticResource IconLock}"
                      Stretch="Uniform"
                      Stroke="{StaticResource PrimaryBrush}"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeThickness="1.75" />

                <TextBlock HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="설정 접근 인증" />

                <TextBlock Margin="0,8,0,22"
                           HorizontalAlignment="Center"
                           FontSize="13.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="관리자 설정 화면으로 이동하려면 비밀번호를 입력하세요."
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <TextBlock Margin="2,0,0,8"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="비밀번호" />

                <PasswordBox x:Name="PasswordInput"
                             Height="44"
                             Padding="14,0"
                             FontSize="15"
                             helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernPasswordBoxStyle}">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
                    </PasswordBox.InputBindings>
                </PasswordBox>

                <!-- 오류 메시지 배너 -->
                <Border Margin="0,12,0,0"
                        Padding="12,9"
                        Background="{StaticResource DangerBgBrush}"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DangerFgBrush}"
                               Text="{Binding ErrorMessage}" />
                </Border>

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Background="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="1"
                            Command="{Binding ConfirmCommand}"
                            Style="{StaticResource DialogActionButtonStyle}">
                        <TextBlock FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="확인" />
                    </Button>

                    <Button Grid.Column="2"
                            Background="White"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource DialogActionButtonStyle}">
                        <TextBlock FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="취소" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
