    </GeometryGroup>

    <!-- 삭제 -->
    <GeometryGroup x:Key="IconTrash">
        <LineGeometry StartPoint="3,6" EndPoint="21,6" />
        <PathGeometry Figures="M 8,6 V 4 A 1,1 0 0 1 9,3 H 15 A 1,1 0 0 1 16,4 V 6" />
        <PathGeometry Figures="M 19,6 V 20 A 1.5,1.5 0 0 1 17.5,21.5 H 6.5 A 1.5,1.5 0 0 1 5,20 V 6" />
    </GeometryGroup>

    <!-- 정보 -->
    <GeometryGroup x:Key="IconInfo">
        <EllipseGeometry Center="12,12" RadiusX="9.5" RadiusY="9.5" />
        <LineGeometry StartPoint="12,11" EndPoint="12,16.5" />
        <LineGeometry StartPoint="12,7.5" EndPoint="12,8" />
    </GeometryGroup>

    <!-- 경고 -->
    <GeometryGroup x:Key="IconAlert">
        <PathGeometry Figures="M 10.29,3.86 L 1.82,18 A 2,2 0 0 0 3.53,21 H 20.47 A 2,2 0 0 0 22.18,18 L 13.71,3.86 A 2,2 0 0 0 10.29,3.86 Z" />
        <LineGeometry StartPoint="12,9" EndPoint="12,13.5" />
        <LineGeometry StartPoint="12,17" EndPoint="12,17.5" />
    </GeometryGroup>

    <!-- 실행 (Play) -->
    <GeometryGroup x:Key="IconPlay">
        <EllipseGeometry Center="12,12" RadiusX="9.5" RadiusY="9.5" />
        <PathGeometry Figures="M 10,8.5 L 16,12 L 10,15.5 Z" />
    </GeometryGroup>

    <!-- 닫기 / 화살표 -->
    <GeometryGroup x:Key="IconClose">
        <LineGeometry StartPoint="6,6" EndPoint="18,18" />
        <LineGeometry StartPoint="18,6" EndPoint="6,18" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconChevronRight">
        <PathGeometry Figures="M 9,6 L 15,12 L 9,18" />
    </GeometryGroup>

</ResourceDictionary>
