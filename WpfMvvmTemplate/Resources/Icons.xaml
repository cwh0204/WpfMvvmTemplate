    <GeometryGroup x:Key="IconPrinter">
        <PathGeometry Figures="M 6,9 V 3 H 18 V 9" />
        <PathGeometry Figures="M 6,17 H 4 A 2,2 0 0 1 2,15 V 11 A 2,2 0 0 1 4,9 H 20 A 2,2 0 0 1 22,11 V 15 A 2,2 0 0 1 20,17 H 18" />
