<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 24x24 규격 통일 선형(Thin-Stroke) 벡터 아이콘 세트 -->

    <!-- 시험 (압력 게이지) -->
    <GeometryGroup x:Key="IconGauge">
        <PathGeometry Figures="M 12,14 L 16,10" />
        <PathGeometry Figures="M 3.34,19 A 10,10 0 1 1 20.66,19" />
        <LineGeometry StartPoint="6,19" EndPoint="18,19" />
    </GeometryGroup>

    <!-- 결과 검색 (차트/리포트) -->
    <GeometryGroup x:Key="IconSearchChart">
        <RectangleGeometry Rect="3,3,18,18" RadiusX="2.5" RadiusY="2.5" />
        <LineGeometry StartPoint="8,16" EndPoint="8,12" />
        <LineGeometry StartPoint="12,16" EndPoint="12,8" />
        <LineGeometry StartPoint="16,16" EndPoint="16,10" />
    </GeometryGroup>

