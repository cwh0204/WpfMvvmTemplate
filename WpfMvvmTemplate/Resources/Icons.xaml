    </GeometryGroup>

    <!-- 종료 (전원) -->
    <GeometryGroup x:Key="IconPower">
        <PathGeometry Figures="M 18.36,6.64 A 9,9 0 1 1 5.64,6.64" />
        <LineGeometry StartPoint="12,2" EndPoint="12,12" />
    </GeometryGroup>

    <!-- PLC 칩 -->
    <GeometryGroup x:Key="IconPlcChip">
        <RectangleGeometry Rect="5,5,14,14" RadiusX="2" RadiusY="2" />
        <RectangleGeometry Rect="9,9,6,6" RadiusX="0.8" RadiusY="0.8" />
        <LineGeometry StartPoint="9,2" EndPoint="9,5" />
        <LineGeometry StartPoint="15,2" EndPoint="15,5" />
        <LineGeometry StartPoint="9,19" EndPoint="9,22" />
        <LineGeometry StartPoint="15,19" EndPoint="15,22" />
        <LineGeometry StartPoint="2,9" EndPoint="5,9" />
        <LineGeometry StartPoint="2,15" EndPoint="5,15" />
        <LineGeometry StartPoint="19,9" EndPoint="22,9" />
        <LineGeometry StartPoint="19,15" EndPoint="22,15" />
    </GeometryGroup>

    <!-- 자물쇠 -->
    <GeometryGroup x:Key="IconLock">
        <RectangleGeometry Rect="5,11,14,10" RadiusX="2" RadiusY="2" />
        <PathGeometry Figures="M 8,11 V 7 A 4,4 0 0 1 16,7 V 11" />
        <LineGeometry StartPoint="12,15" EndPoint="12,17" />
    </GeometryGroup>

    <!-- 홈 -->
    <GeometryGroup x:Key="IconHome">
        <PathGeometry Figures="M 3,10 L 12,3 L 21,10 V 20 A 1.5,1.5 0 0 1 19.5,21.5 H 4.5 A 1.5,1.5 0 0 1 3,20 Z" />
        <PathGeometry Figures="M 9,21.5 V 13 H 15 V 21.5" />
