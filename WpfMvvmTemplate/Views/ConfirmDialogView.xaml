<UserControl x:Class="WpfMvvmTemplate.Views.ConfirmDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WpfMvvmTemplate.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ConfirmDialogViewModel}"
             FontFamily="Pretendard, Malgun Gothic, Segoe UI"
             UseLayoutRounding="True"
             mc:Ignorable="d">

    <Grid Background="#520F172A">
        <Border Width="420"
                Padding="30,26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource AnimatedModalCardStyle}">
            <StackPanel>
                <Path Width="32"
                      Height="32"
                      Margin="0,0,0,14"
                      HorizontalAlignment="Center"
                      Stretch="Uniform"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeThickness="1.75">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource IconInfo}" />
                            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource IconAlert}" />
                                    <Setter Property="Stroke" Value="{StaticResource DangerFgBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <TextBlock HorizontalAlignment="Center"
                           FontSize="18.5"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding Title}" />

                <TextBlock Margin="0,10,0,24"
                           HorizontalAlignment="Center"
                           FontSize="13.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           LineHeight="21"
                           Text="{Binding Message}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            BorderThickness="1"
                            Command="{Binding ConfirmCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource DialogActionButtonStyle}" TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DangerFgBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerFgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="{Binding ConfirmText}" />
                    </Button>

                    <Button Grid.Column="1"
                            Width="170"
                            Margin="10,0,0,0"
                            Background="White"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource DialogActionButtonStyle}"
                            Visibility="{Binding IsConfirmMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding CancelText}" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
