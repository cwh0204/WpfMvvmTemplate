<UserControl
    x:Class="WpfMvvmTemplate.Views.TestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:WpfMvvmTemplate.Models"
    xmlns:vm="clr-namespace:WpfMvvmTemplate.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:TestViewModel}"
    d:DesignHeight="850"
    d:DesignWidth="1440"
    Background="{StaticResource WindowBackgroundBrush}"
    FontFamily="Pretendard, Malgun Gothic, Segoe UI"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ==================== 1. 상단 풀폭 헤더 바 ====================  -->
        <Border
            Grid.Row="0"
            Padding="24,0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Path
                        Width="18"
                        Height="18"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconGauge}"
                        Stretch="Uniform"
                        Stroke="{StaticResource PrimaryBrush}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.75" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16.5"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="장비 시험" />
                </StackPanel>

                <!--  중앙: 자동 / 매뉴얼 세그먼트 탭  -->
                <Border
                    Grid.Column="1"
                    Padding="4"
                    VerticalAlignment="Center"
                    Background="#F1F5F9"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            Command="{Binding SwitchToAutoCommand}"
                            Content="자동 시험"
                            IsChecked="{Binding IsAutoMode, Mode=OneWay}"
                            Style="{StaticResource ModeTabStyle}" />
                        <RadioButton
                            Margin="4,0,0,0"
                            Command="{Binding SwitchToManualCommand}"
                            Content="매뉴얼 시험"
                            IsChecked="{Binding IsManualMode, Mode=OneWay}"
                            Style="{StaticResource ModeTabStyle}" />
                    </StackPanel>
                </Border>

                <!--  우측: 장비 연결 상태 배지 + 메인 화면 버튼  -->
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Height="32"
                        Margin="0,0,10,0"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        CornerRadius="16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource WarningBgBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WarningFgBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessFgBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource WarningFgBrush}" />
                                        <Setter Property="Text" Value="장비 미연결" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessFgBrush}" />
                                                <Setter Property="Text" Value="장비 연결됨" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button
                        Background="White"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1"
                        Command="{Binding ReturnToMainCommand}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Style="{StaticResource ModernButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Width="15"
                                Height="15"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource IconHome}"
                                Stretch="Uniform"
                                Stroke="{StaticResource TextSecondaryBrush}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.75" />
                            <TextBlock VerticalAlignment="Center" Text="메인 화면" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ==================== 2-A. 자동 시험 화면 ====================  -->
        <Grid
            Grid.Row="1"
            Margin="16,14,16,16"
            Visibility="{Binding IsAutoMode, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  좌측 제어 영역  -->
            <Border
                Grid.Column="0"
                Margin="0,0,14,0"
                Padding="16"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Effect="{StaticResource SoftCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  필수 공통 5종 입력 영역  -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock
                            Margin="2,0,0,4"
                            FontSize="12.5"
                            FontWeight="Bold"
                            Foreground="#475569"
                            Text="시험 번호" />
                        <TextBox
                            FontFamily="Consolas"
                            Style="{StaticResource TestMetaTextBoxStyle}"
                            Text="{Binding TestNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="2,8,0,4"
                            FontSize="12.5"
                            FontWeight="Bold"
                            Foreground="#475569"
                            Text="시험자" />
                        <TextBox Style="{StaticResource TestMetaTextBoxStyle}" Text="{Binding TesterName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="2,8,0,4"
                            FontSize="12.5"
                            FontWeight="Bold"
                            Foreground="#475569"
                            Text="차량번호" />
                        <TextBox
                            FontFamily="Consolas"
                            Style="{StaticResource TestMetaTextBoxStyle}"
                            Text="{Binding CarNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="2,8,0,4"
                            FontSize="12.5"
                            FontWeight="Bold"
                            Foreground="#475569"
                            Text="편성번호" />
                        <TextBox
                            FontFamily="Consolas"
                            Style="{StaticResource TestMetaTextBoxStyle}"
                            Text="{Binding FormationNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="2,8,0,4"
                            FontSize="12.5"
                            FontWeight="Bold"
                            Foreground="#475569"
                            Text="시리얼넘버" />
                        <TextBox
                            FontFamily="Consolas"
                            Style="{StaticResource TestMetaTextBoxStyle}"
                            Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!--  계층형 시험 항목 선택 영역  -->
                    <ScrollViewer
                        Grid.Row="1"
                        Margin="0,6,0,12"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock
                                Margin="2,0,0,7"
                                FontSize="12.5"
                                FontWeight="Bold"
                                Foreground="#475569"
                                Text="시험 항목 선택" />

                            <ItemsControl ItemsSource="{Binding TestSelectionGroups}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TestSelectionGroup}">
                                        <StackPanel Margin="0,0,0,6">
                                            <CheckBox
                                                Content="{Binding Title}"
                                                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                Style="{StaticResource ParentTestCheckStyle}" />

                                            <Border
                                                Margin="14,3,0,2"
                                                Padding="10,2,0,2"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="2,0,0,0"
                                                Visibility="{Binding HasSubItems, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl ItemsSource="{Binding SubItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:TestSubItem}">
                                                            <CheckBox
                                                                Content="{Binding CheckBoxTitle}"
                                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                Style="{StaticResource SubItemCheckStyle}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  시작 / 중단 버튼  -->
                    <StackPanel Grid.Row="2">
                        <Button
                            Height="46"
                            Background="{StaticResource PrimaryBrush}"
                            Command="{Binding StartAutoTestCommand}"
                            Content="시험 시작"
                            Style="{StaticResource ModernButtonStyle}" />

                        <Button
                            Height="42"
                            Margin="0,8,0,0"
                            Background="#DC2626"
                            Command="{Binding StopAutoTestCommand}"
                            Content="시험 중단"
                            Style="{StaticResource ModernButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  우측 메인 영역: 실시간 계측 대시보드 + 결과 테이블  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  상단: 장비별 실시간 계측 패널 (교체/확장 영역)  -->
                <Border
                    Grid.Row="0"
                    Padding="18"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <StackPanel
                            Margin="0,0,0,14"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Border
                                Width="4"
                                Height="18"
                                Margin="0,0,10,0"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="2" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="15.5"
                                FontWeight="ExtraBold"
                                Foreground="#0F172A"
                                Text="{Binding ActiveStepTitle}" />
                            <Border
                                Margin="12,0,0,0"
                                Padding="10,3"
                                Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="6">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="{Binding ActiveCategoryBadge}" />
                            </Border>
                        </StackPanel>

                        <!--  [장비별 커스텀 영역] 시험기 특성에 맞게 센서 카드/게이지/밸브 인디케이터로 교체  -->
                        <UniformGrid Margin="0,0,0,12" Columns="4">
                            <Border Margin="0,0,10,0" Style="{StaticResource SensorMetricCardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="3"
                                                Height="12"
                                                Margin="0,0,7,0"
                                                Background="{StaticResource PrimaryBrush}"
                                                CornerRadius="1.5" />
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="#334155"
                                                Text="채널 1 · 입력" />
                                        </StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="11.5"
                                            Foreground="#64748B"
                                            Text="센서 예시" />
                                    </DockPanel>
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="24"
                                            FontWeight="ExtraBold"
                                            Foreground="#0F172A"
                                            Text="{Binding Sensor1Value, StringFormat={}{0:F2}}" />
                                        <TextBlock
                                            Margin="5,9,0,0"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#64748B"
                                            Text="unit" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,10,0" Style="{StaticResource SensorMetricCardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="3"
                                                Height="12"
                                                Margin="0,0,7,0"
                                                Background="{StaticResource AccentHoverBrush}"
                                                CornerRadius="1.5" />
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="#334155"
                                                Text="채널 2 · 기준" />
                                        </StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="11.5"
                                            Foreground="#64748B"
                                            Text="센서 예시" />
                                    </DockPanel>
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="24"
                                            FontWeight="ExtraBold"
                                            Foreground="#0F172A"
                                            Text="{Binding Sensor2Value, StringFormat={}{0:F2}}" />
                                        <TextBlock
                                            Margin="5,9,0,0"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#64748B"
                                            Text="unit" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,10,0" Style="{StaticResource SensorMetricCardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="3"
                                                Height="12"
                                                Margin="0,0,7,0"
                                                Background="#0D9488"
                                                CornerRadius="1.5" />
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="#334155"
                                                Text="채널 3 · 출력 A" />
                                        </StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="11.5"
                                            Foreground="#64748B"
                                            Text="센서 예시" />
                                    </DockPanel>
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="24"
                                            FontWeight="ExtraBold"
                                            Foreground="#0F172A"
                                            Text="{Binding Sensor3Value, StringFormat={}{0:F2}}" />
                                        <TextBlock
                                            Margin="5,9,0,0"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#64748B"
                                            Text="unit" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SensorMetricCardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="3"
                                                Height="12"
                                                Margin="0,0,7,0"
                                                Background="#6366F1"
                                                CornerRadius="1.5" />
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="#334155"
                                                Text="채널 4 · 출력 B" />
                                        </StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="11.5"
                                            Foreground="#64748B"
                                            Text="센서 예시" />
                                    </DockPanel>
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="24"
                                            FontWeight="ExtraBold"
                                            Foreground="#0F172A"
                                            Text="{Binding Sensor4Value, StringFormat={}{0:F2}}" />
                                        <TextBlock
                                            Margin="5,9,0,0"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#64748B"
                                            Text="unit" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!--  현재 단계 진행 상태 배너  -->
                        <Border
                            Padding="16,11"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <DockPanel>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontSize="12.5"
                                        FontWeight="Bold"
                                        Foreground="#475569"
                                        Text="현재 계측치" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="17"
                                        FontWeight="ExtraBold"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        Text="{Binding ActiveLiveMetric}" />
                                </StackPanel>

                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Ellipse
                                        Width="9"
                                        Height="9"
                                        Margin="0,0,10,0"
                                        Fill="{StaticResource PrimaryBrush}" />
                                    <TextBlock
                                        FontSize="13.5"
                                        FontWeight="Bold"
                                        Foreground="#0F172A"
                                        Text="{Binding StatusMessage}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  하단: 선택된 시험 항목 결과 테이블  -->
                <Border
                    Grid.Row="1"
                    Margin="0,14,0,0"
                    Padding="14"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource SoftCardShadow}">
                    <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        ItemsSource="{Binding SelectedTestItems}"
                        RowHeight="38"
                        SelectedItem="{Binding SelectedTestItem}"
                        Style="{StaticResource ModernDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="55"
                                Binding="{Binding StepNo}"
                                Header="순번" />
                            <DataGridTextColumn
                                Width="160"
                                Binding="{Binding ItemName}"
                                FontWeight="Bold"
                                Header="시험 항목" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Category}"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryBrush}"
                                Header="구분" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding StandardSpec}"
                                Foreground="#475569"
                                Header="합격 판정 기준" />
                            <DataGridTextColumn
                                Width="205"
                                Binding="{Binding MeasuredValue}"
                                FontFamily="Consolas"
                                FontWeight="Bold"
                                Header="측정값 / 진행상태" />
                            <DataGridTemplateColumn
                                Width="96"
                                Header="판정"
                                HeaderStyle="{StaticResource CenteredDataGridHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="66"
                                            Height="24"
                                            HorizontalAlignment="Center"
                                            CornerRadius="12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Result}" Value="OK">
                                                            <Setter Property="Background" Value="#DCFCE7" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Result}" Value="NG">
                                                            <Setter Property="Background" Value="#FEE2E2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Result}" Value="진행중">
                                                            <Setter Property="Background" Value="#E0F2FE" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Text="{Binding Result}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="OK">
                                                                <Setter Property="Foreground" Value="#15803D" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="NG">
                                                                <Setter Property="Foreground" Value="#B91C1C" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="진행중">
                                                                <Setter Property="Foreground" Value="#0369A1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!--  ==================== 2-B. 매뉴얼 시험 화면 (장비별 계통도/수동 제어 교체 슬롯) ====================  -->
        <Border
            Grid.Row="1"
            Margin="16,14,16,16"
            Background="White"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Effect="{StaticResource SoftCardShadow}"
            Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="ExtraBold"
                    Foreground="#0F172A"
                    Text="매뉴얼 시험 (장비별 커스텀 영역)" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="이 영역에 각 시험기 전용 계통도(Mimic) 또는 수동 제어 UserControl을 배치하세요." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

