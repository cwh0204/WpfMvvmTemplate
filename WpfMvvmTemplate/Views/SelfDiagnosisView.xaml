<UserControl x:Class="WpfMvvmTemplate.Views.SelfDiagnosisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:WpfMvvmTemplate.Models"
             xmlns:vm="clr-namespace:WpfMvvmTemplate.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SelfDiagnosisViewModel}"
             FontFamily="Pretendard, Malgun Gothic, Segoe UI"
             UseLayoutRounding="True"
             mc:Ignorable="d">

    <!-- 반투명 딤 배경 -->
    <Grid Background="#520F172A">
        <Border Width="500"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource AnimatedModalCardStyle}">
            <StackPanel>
                <!-- 상단 타이틀 -->
                <TextBlock HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="시스템 자가 진단" />

                <TextBlock Margin="0,6,0,18"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding DetailMessage}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <!-- 개별 진단 항목 안내 라벨 -->
                <DockPanel Margin="2,0,2,8">
                    <TextBlock DockPanel.Dock="Left"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="점검 항목" />
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="항목 클릭 시 개별 진단" />
                </DockPanel>

                <!-- 개별 진단 항목 리스트 -->
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:DiagnosisItem}">
                                <Button Command="{Binding RunCommand}"
                                        Style="{StaticResource DiagnosisItemCardButtonStyle}"
                                        ToolTip="클릭하여 개별 진단을 실행합니다.">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 좌측 선형 아이콘 -->
                                        <Path Grid.Column="0"
                                              Width="26"
                                              Height="26"
                                              Margin="4,0,2,0"
                                              VerticalAlignment="Center"
                                              Data="{Binding Icon}"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource PrimaryBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeThickness="1.75" />

                                        <!-- 중앙 항목명 / 대상 정보 / 서브 메시지 -->
                                        <StackPanel Grid.Column="1"
                                                    Margin="14,0"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="14.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding Title}" />
                                                <TextBlock Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Text="{Binding TargetInfo}" />
                                            </StackPanel>

                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding SubMessage}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- 우측 상태 배지 + 화살표 -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <Border Height="26"
                                                    MinWidth="58"
                                                    Padding="10,0"
                                                    CornerRadius="13">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E5E7EB" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DiagnosisStatus.Checking}">
                                                                <Setter Property="Background" Value="{StaticResource InfoBgBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DiagnosisStatus.Normal}">
                                                                <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DiagnosisStatus.Error}">
                                                                <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding StatusText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DiagnosisStatus.Checking}">
                                                                    <Setter Property="Foreground" Value="{StaticResource InfoFgBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DiagnosisStatus.Normal}">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessFgBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DiagnosisStatus.Error}">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerFgBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Path Width="14"
                                                  Height="14"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Data="{StaticResource IconChevronRight}"
                                                  Stretch="Uniform"
                                                  Stroke="{StaticResource TextMutedBrush}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="1.75" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 하단 구분선 -->
                <Border Height="1"
                        Margin="0,12,0,18"
                        Background="{StaticResource BorderSubtleBrush}" />

                <!-- 하단 액션 버튼 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Background="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="1"
                            Command="{Binding StartDiagnosisCommand}"
                            Style="{StaticResource DialogActionButtonStyle}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Path Width="17"
                                  Height="17"
                                  Margin="0,0,8,0"
                                  Data="{StaticResource IconPlay}"
                                  Stretch="Uniform"
                                  Stroke="White"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.75" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="전체 진단 시작" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Background="White"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource DialogActionButtonStyle}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Path Width="15"
                                  Height="15"
                                  Margin="0,0,8,0"
                                  Data="{StaticResource IconClose}"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.75" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="닫기" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
