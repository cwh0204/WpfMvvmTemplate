<UserControl x:Class="WpfMvvmTemplate.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:WpfMvvmTemplate.Models"
             xmlns:vm="clr-namespace:WpfMvvmTemplate.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             mc:Ignorable="d">

    <Grid Background="{StaticResource HomeBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.06*" MinWidth="24" />
            <ColumnDefinition Width="0.88*" />
            <ColumnDefinition Width="0.06*" MinWidth="24" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.9*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0.6*" />
            <RowDefinition Height="2.2*" />
            <RowDefinition Height="0.35*" />
            <RowDefinition Height="0.8*" MinHeight="64" />
            <RowDefinition Height="0.25*" MinHeight="16" />
        </Grid.RowDefinitions>

        <!-- 1. 상단 타이틀 영역 -->
        <Viewbox Grid.Row="1"
                 Grid.Column="1"
                 MaxHeight="135"
                 HorizontalAlignment="Center"
                 StretchDirection="DownOnly">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="56"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           Text="{Binding Title}" />

                <Border Width="68"
                        Height="3"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="1.5" />

                <TextBlock Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding Subtitle}" />
            </StackPanel>
        </Viewbox>

        <!-- 2. 중앙 메뉴 카드 영역 (해상도별 비율 자동 적응형) -->
        <Viewbox Grid.Row="3"
                 Grid.Column="1"
                 MaxWidth="1600"
                 MaxHeight="330"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Stretch="Uniform">
            <ItemsControl Width="1480"
                          Height="295"
                          ItemsSource="{Binding MenuItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:MenuCardItem}">
                        <Button Command="{Binding Command}"
                                Style="{StaticResource MenuCardButtonStyle}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox MaxWidth="68"
                                         MaxHeight="68"
                                         Margin="0,0,0,26"
                                         HorizontalAlignment="Center">
                                    <Path Width="24"
                                          Height="24"
                                          Data="{Binding Icon}"
                                          Stretch="Uniform"
                                          Stroke="{StaticResource PrimaryBrush}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="0.85" />
                                </Viewbox>

                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding Title}" />

                                <TextBlock Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding Subtitle}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Viewbox>

        <!-- 3. 하단 우측 로고 영역 -->
        <Viewbox Grid.Row="5"
                 Grid.Column="1"
                 MaxHeight="78"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Stretch="Uniform">
            <Image Source="pack://application:,,,/Resources/Images/Logo-img.png" />
        </Viewbox>
    </Grid>
</UserControl>
